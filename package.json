    "morgan"                   : "^1.10.0",
    "node-geocoder"            : "^4.3.0",
    "node-mailer"              : "^0.1.1",
    "redis"                    : "^6.0.0",
    "reflect-metadata"         : "^0.2.2",
    "slugify"                  : "^1.6.6",
    "xss"                      : "^1.0.14",
    "zod"                      : "^4.4.3"
